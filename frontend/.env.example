# FinSplit Frontend Environment Variables
# Leave empty in local development to use Vite proxy (target: http://localhost:5000)
# When deploying to Vercel, set these in Vercel Project Settings > Environment Variables:

# (Optional) Overrides relative /api paths to an absolute backend URL.
# Not needed if vercel.json rewrites are configured.
VITE_API_URL=

# Direct Render backend URL for health pings.
# Bypasses the Vercel proxy to avoid Cloudflare 429 bot-challenges on server-to-server hops.
# Example: https://your-backend-name.onrender.com/api/health
VITE_RENDER_HEALTH_URL=
