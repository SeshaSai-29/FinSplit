# FinSplit Backend Environment Configuration (Render / Production)

# Port is automatically assigned by Render (Leave blank or set to 5000 for local dev)
PORT=5000

# Set NODE_ENV to production on Render
NODE_ENV=production

# MongoDB Atlas Connection String
# Ensure network access whitelist includes 0.0.0.0/0 on cloud.mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/personal_finance_tracker?retryWrites=true&w=majority

# Secret key used for signing JWT tokens (use a random string, min 32 characters)
JWT_SECRET=your_jwt_secret_key_here

# The URL where your Vercel frontend is hosted (No trailing slash)
# e.g. https://your-project.vercel.app (or http://localhost:5173 for local dev)
CLIENT_URL=https://your-frontend.vercel.app

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Backend Google Callback URL (Points to your Render backend service)
GOOGLE_CALLBACK_URL=https://personal-finance-tracker-arn6.onrender.com/api/auth/google/callback
